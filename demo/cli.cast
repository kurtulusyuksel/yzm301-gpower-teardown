[0.000050400000000010434,"o","PairedLab | YZM301 | Educational paired-means t-test reimplementation\r\n"]
[0.00020020000000000947,"o","Synthetic example: before/after blood pressure, dz = 10 / 20 = 0.5.\r\nN means patients / matched pairs.\r\n\r\n"]
[5.005621099999999,"o","\r\nRequired pairs, two-sided, alpha=.05, target=.95\r\n$ node --import tsx src/cli.ts --test t-paired --tails 2 --d .5 --alpha .05 --mode a-priori --power .95\r\n"]
