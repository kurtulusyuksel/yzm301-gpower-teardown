[18.0016192,"o","\r\nAchieved power for 54 matched pairs\r\n$ node --import tsx src/cli.ts --test t-paired --tails 2 --d .5 --alpha .05 --mode post-hoc --n 54\r\n"]
[18.4238709,"o","{\"n_total\":54,\"actual_power\":0.9502,\"critical\":2.0057,\"df\":53,\"ncp\":3.6742}\r\nexit=0\r\n"]
